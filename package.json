{
  "name": "dsh-image-context-menu",
  "version": "0.1.0",
  "description": "Original-image context menus for Codex-generated images in DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "author": "Moh114514",
  "repository": { "type": "git", "url": "git+https://github.com/Moh114514/dsh-image-context-menu.git" },
  "homepage": "https://github.com/Moh114514/dsh-image-context-menu#readme",
  "bugs": { "url": "https://github.com/Moh114514/dsh-image-context-menu/issues" },
  "keywords": ["dsh-plugin", "deepseek-harness", "image", "context-menu", "codex"],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["lib/*.js", "locale/*.json", "cordis.patch.yml", "icon.svg", "README.md", "README.zh.md", "PUBLISHING.md", "LICENSE", "THIRD_PARTY_NOTICES.md", "CHANGELOG.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-isolation=none test/*.test.mjs",
    "check": "node scripts/build.mjs && node --test --test-isolation=none test/*.test.mjs && node scripts/check-package.mjs"
  },
  "engines": { "node": ">=22.19.0", "dsh": "0.2.2-rc.1" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-context-menu": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-file-actions": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.1",
    "dsh-codex-subscription": "3.2.6",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-file-actions",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "dsh-codex-subscription"
      ]
    }
  },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" }
}
